# FanKarr : configuration du binaire Bun
# Copier ce fichier en .env dans le même dossier que le binaire fankarr

# ── Authentification ──────────────────────────────────────────────────────────

# Clé secrète JWT (générée automatiquement si absente ; il est conseillé de la fixer)
# JWT_SECRET=changez-moi-avec-une-chaine-aleatoire-longue

# Durée de validité de la session
# Exemples : "1d", "7d", "30d", "1y" ; "never" ou "0" : pas d'expiration
# AUTH_TOKEN_EXPIRY=30d

# ── Serveur ───────────────────────────────────────────────────────────────────

# Port d'écoute (défaut : 9898)
# PORT=9898
